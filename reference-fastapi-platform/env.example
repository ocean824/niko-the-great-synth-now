# Application database; use a least-privilege runtime account in production.
DATABASE_URL=postgresql+psycopg://synthnow:CHANGE_ME@postgres:5432/synthnow

# Private upload/object-storage adapter configuration. Local development defaults to /app/private_uploads.
SYNTH_NOW_UPLOAD_DIR=/app/private_uploads
SYNTH_NOW_WORKER_POLL_INTERVAL_SECONDS=1
LOG_LEVEL=INFO

# Production authentication and signed-result token settings; never use X-User-Id outside local development.
SYNTH_NOW_AUTH_MODE=oauth_jwt
SYNTH_NOW_RESULT_TOKEN_SIGNING_KEY=CHANGE_ME_USE_SECRET_MANAGER
SYNTH_NOW_ALLOWED_ORIGINS=https://app.example.com
SYNTH_NOW_METRICS_TOKEN=CHANGE_ME_USE_SECRET_MANAGER

# Redis is optional at runtime; cache failure falls back to PostgreSQL. Use rediss:// and a CA-verified
# managed Redis endpoint in production. Never expose this endpoint to browsers.
SYNTH_NOW_REDIS_URL=rediss://:CHANGE_ME@redis.example.internal:6380/0
SYNTH_NOW_CACHE_ENABLED=true
SYNTH_NOW_CACHE_KEY_PREFIX=synthnow
SYNTH_NOW_PRESET_DETAIL_CACHE_TTL_SECONDS=300
SYNTH_NOW_PRESET_SEARCH_CACHE_TTL_SECONDS=60
SYNTH_NOW_SESSION_CACHE_TTL_SECONDS=900
SYNTH_NOW_CACHE_LOCK_TTL_SECONDS=10

# Object storage should be private and accessed through server-issued signed URLs.
SYNTH_NOW_OBJECT_STORAGE_BUCKET=synth-now-private
SYNTH_NOW_OBJECT_STORAGE_ENDPOINT=
SYNTH_NOW_OBJECT_STORAGE_REGION=
