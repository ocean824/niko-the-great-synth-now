{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synth-now-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "staging",
    "R2_UPLOADS_BUCKET": "synth-now-private-uploads",
    "R2_PRESIGN_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "STRIPE_WEB_PRICE_ID": "REPLACE_WITH_STRIPE_PRICE_ID",
    "RESEND_FROM_EMAIL": "Synth Now <account@REPLACE_WITH_VERIFIED_SUBDOMAIN>",
    "OIDC_ISSUER": "https://REPLACE_WITH_IDENTITY_PROVIDER/",
    "OIDC_AUDIENCE": "synth-now-api",
    "OIDC_JWKS_URL": "https://REPLACE_WITH_IDENTITY_PROVIDER/.well-known/jwks.json"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }],
  "r2_buckets": [
    { "binding": "R2_UPLOADS", "bucket_name": "synth-now-private-uploads" },
    { "binding": "R2_APPROVED_ASSETS", "bucket_name": "synth-now-approved-assets" }
  ],
  "queues": {
    "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "synth-now-analysis" }]
  }
}
